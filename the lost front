local function RefreshAllUI()
    for _, f in ipairs(UI_Refresh) do f() end

    local parts = {}
    if Config.ESP_Enabled then table.insert(parts, "ESP") end
    if Config.AIM_Enabled then table.insert(parts, "AIM") end
    if Config.TRIGGER_Enabled then table.insert(parts, "TRIG") end
    if Config.DESYNC_Enabled then table.insert(parts, "DSYNC") end
    if Config.RADAR_Enabled then table.insert(parts, "RADAR") end
    FooterLabel.Text = #parts > 0 and table.concat(parts, " | ") or "HIDDEN"

    for i, btn in ipairs(TabButtons) do
        btn.BackgroundColor3 = (TabNames[i] == TabNames[Config.MENU_Tab]) and Palette.MenuAccent or Palette.MenuTab
    end
end

SelectTab(TabNames[Config.MENU_Tab])
RefreshAllUI()

Connections
Connections.toggleUI = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        Config.MENU_Open = not Config.MENU_Open
        MainFrame.Visible = Config.MENU_Open
        if Config.MENU_Open and minimized then
            minimized = false
            MainFrame.Size = UDim2.new(0, 420, 0, menuH)
            UI.tabFrame.Visible = true
            UI.contentFrame.Visible = true
            UI.footer.Visible = true
            MinBtn.Text = "–"
        end
    elseif input.KeyCode == Enum.KeyCode.Home then
        minimized = not minimized
        if minimized then
            MainFrame.Size = UDim2.new(0, 420, 0, titleH)
            UI.tabFrame.Visible = false
            UI.contentFrame.Visible = false
            UI.footer.Visible = false
            MinBtn.Text = "□"
        else
            MainFrame.Size = UDim2.new(0, 420, 0, menuH)
            UI.tabFrame.Visible = true
            UI.contentFrame.Visible = true
            UI.footer.Visible = true
            MinBtn.Text = "–"
        end
    end
end)

local dragStartPos = nil
local dragFramePos = nil

Connections.titleDragStart = TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStartPos = input.Position
        dragFramePos = MainFrame.Position
    end
end)

Connections.titleDragEnd = TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStartPos = nil
        dragFramePos = nil
    end
end)

Connections.dragMove = UserInputService.InputChanged:Connect(function(input)
    if dragStartPos and dragFramePos and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStartPos
        MainFrame.Position = UDim2.new(0, dragFramePos.X.Offset + delta.X, 0, dragFramePos.Y.Offset + delta.Y)
    end
end)

Connections.charAdded = LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.3)
    Targets.refresh()
end)

Connections.renderLoop = RunService.RenderStepped:Connect(function()
    if Unloaded then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local now = tick()
    if now - Timers.lastTargetRefresh >= Tuning.TargetRefreshRate then
        Targets.refresh()
        Timers.lastTargetRefresh = now
    end
    if now - Timers.lastVisRefresh >= Tuning.VisibilityRefreshRate then
        Targets.refreshVisibility()
        Timers.lastVisRefresh = now
    end
    if now - Timers.lastTeamRefresh >= Tuning.TeamRefreshRate then
        Team.update()
        Timers.lastTeamRefresh = now
    end
    if now - Timers.lastFPVRefresh >= Tuning.FPVRefreshRate then
        Cache.drones = FPV.Scan()
        Timers.lastFPVRefresh = now
    end

    local screenSize = cam.ViewportSize
    local screenCenter = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

    ESP.Step(cam, screenSize, screenCenter)
    FPV.Step(cam)
    UpdateRadar(cam)
    Aimbot.Step(cam, screenCenter)
end)

function Unload()
    Unloaded = true
    for _, con in pairs(Connections) do
        pcall(function() con:Disconnect() end)
    end
    pcall(function() RunService:UnbindFromRenderStep("AimbotCore") end)
    pcall(function() UI.ScreenGui:Destroy() end)
end
